---
const nav = [
  ['Projects', '/projects'],
  ['Research', '/research'],
  ['Open Source', '/open-source'],
  ['Publications', '/publications'],
  ['Notes', '/notes'],
  ['About', '/about'],
];
---
<header class="sticky top-0 z-50 border-b border-white/5 bg-[#06101b]/80 backdrop-blur-xl">
  <div class="shell flex min-h-16 items-center justify-between gap-6">
    <a href="/" class="mono text-sm font-bold tracking-[.16em] text-white">MBT<span class="text-cyan-300">.</span></a>
    <nav class="hidden items-center gap-5 text-sm text-slate-300 md:flex">
      {nav.map(([label, href]) => <a class="transition hover:text-cyan-300" href={href}>{label}</a>)}
    </nav>
    <a href="https://github.com/mberkantastan" target="_blank" rel="noreferrer" class="rounded-full border border-cyan-300/20 px-4 py-2 text-sm text-cyan-200 transition hover:border-cyan-300/50 hover:bg-cyan-300/5">GitHub ↗</a>
  </div>
</header>
