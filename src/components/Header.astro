---
const path = Astro.url.pathname;
const isTr = path === '/tr' || path.startsWith('/tr/');
const prefix = isTr ? '/tr' : '';
const nav = isTr ? [
  ['Projeler', `${prefix}/projects`],
  ['Araştırma', `${prefix}/research`],
  ['Açık Kaynak', `${prefix}/open-source`],
  ['Yayınlar', `${prefix}/publications`],
  ['Teknik Blog', `${prefix}/notes`],
  ['CV', `${prefix}/cv`],
  ['Hakkımda', `${prefix}/about`],
] : [
  ['Projects', '/projects'],
  ['Research', '/research'],
  ['Open Source', '/open-source'],
  ['Publications', '/publications'],
  ['Technical Blog', '/notes'],
  ['CV', '/cv'],
  ['About', '/about'],
];
const languageHref = isTr
  ? (path.replace(/^\/tr(?=\/|$)/, '') || '/')
  : `/tr${path === '/' ? '' : path}`;
---
<header class="sticky top-0 z-50 border-b border-white/5 bg-[#06101b]/85 backdrop-blur-xl">
  <div class="shell flex min-h-16 items-center justify-between gap-4">
    <a href={isTr ? '/tr' : '/'} class="mono text-sm font-bold tracking-[.16em] text-white">MBT<span class="text-cyan-300">.</span></a>
    <nav class="hidden items-center gap-4 text-sm text-slate-300 xl:flex">
      {nav.map(([label, href]) => <a class="transition hover:text-cyan-300" href={href}>{label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a href={languageHref} class="rounded-full border border-white/10 px-3 py-2 text-xs font-bold text-slate-300 transition hover:border-cyan-300/40 hover:text-cyan-200" aria-label="Switch language">{isTr ? 'EN' : 'TR'}</a>
      <a href="https://github.com/mberkantastan" target="_blank" rel="noreferrer" class="rounded-full border border-cyan-300/20 px-3 py-2 text-xs font-bold text-cyan-200 transition hover:border-cyan-300/50 hover:bg-cyan-300/5 sm:px-4 sm:text-sm">GitHub ↗</a>
      <details class="relative xl:hidden">
        <summary class="cursor-pointer list-none rounded-full border border-white/10 px-3 py-2 text-xs font-bold text-slate-300">Menu</summary>
        <nav class="absolute right-0 mt-3 w-56 rounded-2xl border border-white/10 bg-[#081522] p-3 shadow-2xl">
          {nav.map(([label, href]) => <a class="block rounded-xl px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-cyan-200" href={href}>{label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
