---
interface Props { lang?: 'en' | 'tr'; }
const { lang = 'en' } = Astro.props;
const fallback = [
  {
    name: 'DualFuel-Main-Engine',
    description: lang === 'tr' ? 'MAN B&W çift yakıtlı ana makine için etkileşimli simülasyon ve enstrümantasyon prototipi.' : 'Interactive simulation and instrumentation prototype for a MAN B&W dual-fuel main engine.',
    language: 'HTML / JavaScript',
    url: 'https://github.com/mberkantastan/DualFuel-Main-Engine'
  },
  {
    name: 'mberkantastan.github.io',
    description: lang === 'tr' ? 'Bu mühendislik portföyü, araştırma arşivi ve teknik blogun kaynak kodu.' : 'Source code for this engineering portfolio, research archive and technical blog.',
    language: 'Astro / TypeScript',
    url: 'https://github.com/mberkantastan/mberkantastan.github.io'
  }
];
---
<div id="github-repos" class="grid gap-5 md:grid-cols-2">
  {fallback.map(repo => (
    <a class="card block p-6" href={repo.url} target="_blank" rel="noreferrer">
      <div class="flex items-center justify-between gap-4"><span class="mono text-xs text-cyan-300">PUBLIC REPOSITORY</span><span class="text-slate-600">↗</span></div>
      <h3 class="mt-4 text-xl font-bold text-white">{repo.name}</h3>
      <p class="mt-3 min-h-12 text-sm leading-6 text-slate-400">{repo.description}</p>
      <p class="mono mt-5 text-xs text-slate-500">{repo.language}</p>
    </a>
  ))}
</div>
<script define:vars={{ lang }}>
  const root = document.getElementById('github-repos');
  const esc = (value = '') => value.replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  fetch('https://api.github.com/users/mberkantastan/repos?sort=updated&per_page=8&type=owner')
    .then(r => r.ok ? r.json() : Promise.reject())
    .then(repos => {
      const visible = repos.filter(r => !r.fork).slice(0, 6);
      if (!root || !visible.length) return;
      root.innerHTML = visible.map(repo => `
        <a class="card block p-6" href="${esc(repo.html_url)}" target="_blank" rel="noreferrer">
          <div class="flex items-center justify-between gap-4"><span class="mono text-xs text-cyan-300">PUBLIC REPOSITORY</span><span class="text-slate-600">↗</span></div>
          <h3 class="mt-4 text-xl font-bold text-white">${esc(repo.name)}</h3>
          <p class="mt-3 min-h-12 text-sm leading-6 text-slate-400">${esc(repo.description || (lang === 'tr' ? 'GitHub üzerinde yayınlanan açık kaynak çalışma.' : 'Open-source work published on GitHub.'))}</p>
          <div class="mono mt-5 flex flex-wrap gap-4 text-xs text-slate-500"><span>${esc(repo.language || 'Repository')}</span><span>★ ${repo.stargazers_count}</span><span>⑂ ${repo.forks_count}</span></div>
        </a>`).join('');
    })
    .catch(() => {});
</script>
