---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Open Source — M. Berkan Taştan">
  <section class="shell min-h-[65vh] py-20">
    <p class="kicker mb-4">Public code</p>
    <h1 class="max-w-4xl text-4xl font-black tracking-tight text-white sm:text-6xl">Open Source</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-400">Open repositories, reusable tools, documentation and experiments that can be inspected and improved by others.</p>
    <div class="mt-10 card p-6 text-slate-400">This section is ready for content. We will connect Markdown/MDX entries and project metadata in the next iteration.</div>
  </section>
</BaseLayout>
