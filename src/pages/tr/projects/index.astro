---
import { getCollection } from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro';
const projects=(await getCollection('projectsTr')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Projeler — M. Berkan Taştan"><section class="shell min-h-[65vh] py-20"><p class="kicker mb-4">Mühendislik portföyü</p><h1 class="text-4xl font-black sm:text-6xl">Projeler</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-400">Simülasyon yazılımları, mühendislik modelleri, açık kaynak prototipler ve sistem entegrasyonu çalışmaları.</p><div class="mt-10 grid gap-5 md:grid-cols-2">{projects.map(p=><a href={`/tr/projects/${p.id}`} class="card"><img class="project-image" src={p.data.image} alt=""/><div class="p-6"><p class="kicker">{p.data.status}</p><h2 class="mt-4 text-2xl font-bold">{p.data.title}</h2><p class="mt-3 leading-7 text-slate-400">{p.data.description}</p><div class="mt-5 flex flex-wrap gap-2">{p.data.tags.map(t=><span class="tag">{t}</span>)}</div></div></a>)}</div></section></BaseLayout>
