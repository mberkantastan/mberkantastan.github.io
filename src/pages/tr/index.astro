---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
const projects = (await getCollection('projectsTr')).filter(x => x.data.featured).slice(0,2);
const notes = (await getCollection('notesTr')).filter(x => !x.data.draft).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
---
<BaseLayout title="M. Berkan Taştan — Mühendislik & Araştırma">
  <section class="shell grid min-h-[78vh] items-center gap-12 py-20 lg:grid-cols-[1.15fr_.85fr]">
    <div><p class="kicker mb-5">Lider Ar-Ge Mühendisi · Simülasyon · Sistem Entegrasyonu</p><h1 class="max-w-4xl text-5xl font-black leading-[.98] tracking-[-.045em] text-white sm:text-6xl lg:text-7xl">Karmaşık mühendislik sistemlerini <span class="text-cyan-300">test edilebilir sayısal modellere</span> dönüştürüyorum.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate-400">Gemi makineleri, matematiksel modelleme, simülasyon yazılımı, sistem test ve doğrulama ile yazılım-donanım entegrasyonu alanlarında çalışıyorum. Bu site portföyüm, araştırma arşivim, açık kaynak çalışma alanım ve teknik not defterimdir.</p><div class="mt-9 flex flex-wrap gap-3"><a href="/tr/projects" class="rounded-full bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950 hover:bg-cyan-200">Projeleri incele</a><a href="/tr/cv" class="rounded-full border border-white/10 px-5 py-3 text-sm font-bold text-white hover:border-cyan-300/40">CV</a><a href="/tr/research" class="rounded-full border border-white/10 px-5 py-3 text-sm font-bold text-white hover:border-cyan-300/40">Araştırmalar</a></div></div>
    <div class="glass hero-grid rounded-3xl p-6"><div class="mb-6 flex items-center justify-between border-b border-white/5 pb-4"><span class="mono text-xs text-cyan-300">ENGINEERING_PROFILE</span><span class="h-2 w-2 rounded-full bg-emerald-300"></span></div><div class="space-y-5">{['Sistem Simülasyonu & Matematiksel Modelleme','Sistem Test, Doğrulama & Entegrasyon','Gemi Makine & Kontrol Sistemleri','Açık Kaynak & Teknik Araştırma'].map((x,i)=><div><p class="mono text-xs text-slate-500">FOCUS_0{i+1}</p><p class="mt-1 font-semibold">{x}</p></div>)}</div></div>
  </section>
  <section class="shell py-16"><SectionTitle kicker="01 / Öne çıkan" title="Mühendislik sistemi olarak dokümante edilen projeler." text="Mimari, modelleme kararları, doğrulama yaklaşımı, kod ve öğrenimler; şirket içi/proprietary uygulama detayları paylaşılmadan."/><div class="grid gap-5 md:grid-cols-2">{projects.map(p=><a href={`/tr/projects/${p.id}`} class="card"><img class="project-image" src={p.data.image} alt=""/><div class="p-6"><p class="kicker">{p.data.status}</p><h3 class="mt-3 text-2xl font-bold">{p.data.title}</h3><p class="mt-3 leading-7 text-slate-400">{p.data.description}</p></div></a>)}</div></section>
  <section class="shell py-16"><SectionTitle kicker="02 / Teknik blog" title="Devam eden çalışmalardan mühendislik notları."/><div class="grid gap-5 md:grid-cols-2">{notes.map(n=><a class="card p-6" href={`/tr/notes/${n.id}`}><p class="mono text-xs text-slate-500">{n.data.date.toISOString().slice(0,10)}</p><h3 class="mt-3 text-xl font-bold">{n.data.title}</h3><p class="mt-3 text-sm leading-6 text-slate-400">{n.data.description}</p></a>)}</div></section>
</BaseLayout>
