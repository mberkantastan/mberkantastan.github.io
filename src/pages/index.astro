---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
const projects = (await getCollection('projectsEn')).filter(x => x.data.featured).slice(0,2);
const notes = (await getCollection('notesEn')).filter(x => !x.data.draft).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
---
<BaseLayout>
  <section class="shell grid min-h-[78vh] items-center gap-12 py-20 lg:grid-cols-[1.15fr_.85fr]">
    <div>
      <p class="kicker mb-5">Lead R&D Engineer · Simulation · Systems Integration</p>
      <h1 class="max-w-4xl text-5xl font-black leading-[.98] tracking-[-.045em] text-white sm:text-6xl lg:text-7xl">Engineering complex systems into <span class="text-cyan-300">testable digital models.</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-400">I work across marine engineering, mathematical modelling, simulation software, system test & validation and hardware-software integration. This site is my portfolio, research archive, open-source workspace and technical notebook.</p>
      <div class="mt-9 flex flex-wrap gap-3"><a href="/projects" class="rounded-full bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950 hover:bg-cyan-200">Explore projects</a><a href="/cv" class="rounded-full border border-white/10 px-5 py-3 text-sm font-bold text-white hover:border-cyan-300/40">View CV</a><a href="/research" class="rounded-full border border-white/10 px-5 py-3 text-sm font-bold text-white hover:border-cyan-300/40">Research</a></div>
    </div>
    <div class="glass hero-grid relative overflow-hidden rounded-3xl p-6 shadow-2xl shadow-cyan-950/30">
      <div class="mb-6 flex items-center justify-between border-b border-white/5 pb-4"><span class="mono text-xs text-cyan-300">ENGINEERING_PROFILE</span><span class="h-2 w-2 rounded-full bg-emerald-300 shadow-[0_0_14px_rgba(127,255,201,.8)]"></span></div>
      <div class="space-y-5">{['System Simulation & Mathematical Modelling','System Test, Validation & Integration','Marine Machinery & Control Systems','Open Source & Technical Research'].map((x,i)=><div><p class="mono text-xs text-slate-500">FOCUS_0{i+1}</p><p class="mt-1 font-semibold">{x}</p></div>)}</div>
      <div class="mt-7 rounded-2xl border border-cyan-300/10 bg-cyan-300/[.035] p-4 font-mono text-xs leading-6 text-slate-400"><span class="text-cyan-300">$</span> model → integrate → test → validate<br/><span class="text-emerald-300">✓</span> engineering portfolio online</div>
    </div>
  </section>
  <section class="shell py-16"><SectionTitle kicker="01 / Featured work" title="Projects documented as engineering systems." text="Architecture, modelling decisions, validation logic, code and lessons learned — without exposing proprietary implementation details." /><div class="grid gap-5 md:grid-cols-2">{projects.map(p=><a href={`/projects/${p.id}`} class="card"><img class="project-image" src={p.data.image} alt=""/><div class="p-6"><p class="kicker">{p.data.status}</p><h3 class="mt-3 text-2xl font-bold">{p.data.title}</h3><p class="mt-3 leading-7 text-slate-400">{p.data.description}</p><div class="mt-5 flex flex-wrap gap-2">{p.data.tags.slice(0,4).map(t=><span class="tag">{t}</span>)}</div></div></a>)}</div></section>
  <section class="shell py-16"><SectionTitle kicker="02 / Technical blog" title="Engineering notes from ongoing work." text="Compact technical articles on simulation, test, marine systems and software-hardware integration." /><div class="grid gap-5 md:grid-cols-2">{notes.map(n=><a class="card p-6" href={`/notes/${n.id}`}><p class="mono text-xs text-slate-500">{n.data.date.toISOString().slice(0,10)}</p><h3 class="mt-3 text-xl font-bold">{n.data.title}</h3><p class="mt-3 text-sm leading-6 text-slate-400">{n.data.description}</p></a>)}</div></section>
</BaseLayout>
