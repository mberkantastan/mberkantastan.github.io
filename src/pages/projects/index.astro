---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const projects=(await getCollection('projectsEn')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Projects — M. Berkan Taştan" description="Engineering projects in simulation, marine systems, digital twins and systems integration."><section class="shell min-h-[65vh] py-20"><p class="kicker mb-4">Engineering portfolio</p><h1 class="max-w-4xl text-4xl font-black tracking-tight text-white sm:text-6xl">Projects</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-400">Simulation software, engineering models, open-source prototypes and systems-integration work documented with technical context.</p><div class="mt-10 grid gap-5 md:grid-cols-2">{projects.map(p=><a href={`/projects/${p.id}`} class="card"><img class="project-image" src={p.data.image} alt=""/><div class="p-6"><div class="flex items-start justify-between gap-4"><p class="kicker">{p.data.status??'Project'}</p><span class="mono text-xs text-slate-600">{p.data.date.getFullYear()}</span></div><h2 class="mt-4 text-2xl font-bold text-white">{p.data.title}</h2><p class="mt-3 leading-7 text-slate-400">{p.data.description}</p><div class="mt-5 flex flex-wrap gap-2">{p.data.tags.map(t=><span class="tag">{t}</span>)}</div></div></a>)}</div></section></BaseLayout>
