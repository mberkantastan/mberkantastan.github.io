---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){const entries=await getCollection('projectsEn');return entries.map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props; const {Content}=await render(entry);
---
<BaseLayout title={`${entry.data.title} — M. Berkan Taştan`} description={entry.data.description}><article class="shell py-20"><a href="/projects" class="mono text-xs text-cyan-300">← PROJECTS</a><header class="mt-7 max-w-4xl"><p class="kicker">{entry.data.status??'Project'} · {entry.data.date.getFullYear()}</p><h1 class="mt-4 text-4xl font-black tracking-tight text-white sm:text-6xl">{entry.data.title}</h1><p class="mt-6 text-lg leading-8 text-slate-400">{entry.data.description}</p><div class="mt-6 flex flex-wrap gap-2">{entry.data.tags.map(t=><span class="tag">{t}</span>)}</div>{entry.data.repo&&<a href={entry.data.repo} target="_blank" rel="noreferrer" class="mt-6 inline-block rounded-full border border-cyan-300/25 px-5 py-3 text-sm font-bold text-cyan-200">Repository ↗</a>}</header>{entry.data.image&&<img class="mt-10 w-full max-w-5xl rounded-3xl border border-white/10" src={entry.data.image} alt=""/>}<div class="prose-engineering mt-12 max-w-3xl"><Content/></div></article></BaseLayout>
