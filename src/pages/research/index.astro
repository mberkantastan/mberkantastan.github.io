---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
const entries=(await getCollection('researchEn')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Research — M. Berkan Taştan"><section class="shell py-20"><p class="kicker mb-4">Technical investigations</p><h1 class="text-4xl font-black sm:text-6xl">Research</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-400">Structured notes on marine systems, simulation, energy efficiency, control and validation.</p><div class="mt-10 grid gap-5 md:grid-cols-2">{entries.map(e=><a href={`/research/${e.id}`} class="card"><img class="project-image" src={e.data.image} alt=""/><div class="p-6"><p class="mono text-xs text-slate-500">{e.data.date.toISOString().slice(0,10)}</p><h2 class="mt-3 text-2xl font-bold">{e.data.title}</h2><p class="mt-3 leading-7 text-slate-400">{e.data.description}</p><div class="mt-5 flex flex-wrap gap-2">{e.data.tags.map(t=><span class="tag">{t}</span>)}</div></div></a>)}</div></section></BaseLayout>
